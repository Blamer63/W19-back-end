# Copy this file to .env and fill in your values
# Ask a teammate to share the actual secret values with you

JWT_SECRET=your_jwt_secret_here
GOOGLE_PLACES_KEY=your_google_places_api_key_here
GOOGLE_TRANSLATE_API_KEY=your_google_cloud_translation_api_key_here
VISION_API_URL=http://localhost:8000
VISION_TIMEOUT_MS=60000
VISION_SUPPORTED_LANGUAGES=en,es,fr,ja
VISION_ENABLE_CUDA=0
VISION_FORCE_CPU=0
VISION_YOLO_MODEL=yolov8m.pt
VISION_SIGLIP_MODEL=google/siglip-base-patch16-224
