# Copy this file to .env and fill in your values
# Ask a teammate to share the actual secret values with you

JWT_SECRET=your_jwt_secret_here
GOOGLE_PLACES_KEY=your_google_places_api_key_here
GOOGLE_TRANSLATE_API_KEY=your_google_cloud_translation_api_key_here

# Required for real file uploads/downloads in local Docker.
# The backend uses the AWS SDK DefaultCredentialsProvider, so these can also
# come from ~/.aws/credentials or an IAM role outside Docker.
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
# AWS_SESSION_TOKEN=your_temporary_session_token_here
AWS_REGION=ap-southeast-2
AWS_S3_BUCKET_CUSTOMER=fs-kaiday-customer-test
AWS_CLOUDFRONT_DOMAIN=d3i7r8z4cxs3p9.cloudfront.net
# Set to true only for local upload smoke tests. Post-image scanning needs real S3 download access.
AWS_S3_MOCK=false

VISION_API_URL=http://localhost:8000
VISION_TIMEOUT_MS=60000
VISION_SUPPORTED_LANGUAGES=en,es,fr,ja
VISION_ENABLE_CUDA=0
VISION_FORCE_CPU=0
VISION_YOLO_MODEL=yolov8m.pt
VISION_SIGLIP_MODEL=google/siglip-base-patch16-224
